            "@cs/domains/ldap": ["./libs/domains/ldap/src/index.ts"],
            "@cs/domains/ldap-sync": ["./libs/domains/ldap-sync/src/index.ts"],
            "@cs/domains/license": ["./libs/domains/license/src/index.ts"],
            "@cs/domains/mapping-role": ["./libs/domains/mapping-role/src/index.ts"],
            "@cs/domains/mitre": ["./libs/domains/mitre/src/index.ts"],
            "@cs/domains/notification": ["./libs/domains/notification/src/index.ts"],
            "@cs/domains/periodic-scan": ["./libs/domains/periodic-scan/src/index.ts"],
            "@cs/domains/repository": ["./libs/domains/repository/src/index.ts"],
            "@cs/domains/role": ["./libs/domains/role/src/index.ts"],
            "@cs/domains/rule": ["./libs/domains/rule/src/index.ts"],
            "@cs/domains/runtime": ["./libs/domains/runtime/src/index.ts"],
            "@cs/domains/task": ["./libs/domains/task/src/index.ts"],
            "@cs/domains/stat": ["./libs/domains/stat/src/index.ts"],
            "@cs/domains/token": ["./libs/domains/token/src/index.ts"],
            "@cs/domains/user": ["./libs/domains/user/src/index.ts"],
            "@cs/features/admission": ["./libs/features/admission/src/index.ts"],
            "@cs/features/cluster": ["./libs/features/cluster/src/index.ts"],
            "@cs/features/dashboard": ["./libs/features/dashboard/src/index.ts"],
            "@cs/features/error": ["./libs/features/error/src/index.ts"],
            "@cs/features/event": ["./libs/features/event/src/index.ts"],
            "@cs/features/forbidden": ["./libs/features/forbidden/src/index.ts"],
            "@cs/features/image": ["./libs/features/image/src/index.ts"],
            "@cs/features/integration": ["./libs/features/integration/src/index.ts"],
            "@cs/features/inventory": ["./libs/features/inventory/src/index.ts"],
            "@cs/features/rule": ["./libs/features/rule/src/index.ts"],
            "@cs/features/runtime": ["./libs/features/runtime/src/index.ts"],
