{
    "compileOnSave": false,
    "compilerOptions": {
        "rootDir": ".",
        "sourceMap": true,
        "declaration": false,
        "moduleResolution": "bundler",
        "ignoreDeprecations": "5.0",
        "esModuleInterop": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "useDefineForClassFields": false,
        "strictNullChecks": true,
        "importHelpers": true,
        "target": "ES2022",
        "module": "ESNext",
        "lib": ["DOM", "ES2022"],
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "paths": {
            "@cs/api": ["./libs/api/src/index.ts"],
            "@cs/core": ["./libs/core/src/index.ts"],
            "@cs/domains/auth": ["./libs/domains/auth/src/index.ts"],
