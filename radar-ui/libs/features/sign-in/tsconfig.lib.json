{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "../../dist/out-tsc",
        "target": "ES2022",
        "module": "ESNext",
        "declaration": true,
        "declarationMap": true,
        "inlineSources": true,
        "types": ["node"],
        "lib": ["DOM", "ES2022"]
    },
    "angularCompilerOptions": {
        "compilationMode": "partial",
        "strictTemplates": true
    },
    "exclude": [
        "src/test-setup.ts",
        "**/*.spec.ts",
        "**/*.test.ts"
    ],
    "include": ["**/*.ts"]
}
