  "definitions": {
    "ConfigConfigJSON": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "allowList": {
          "$ref": "#/definitions/ConfigJSONFilter",
          "description": "allow_list specifies a list of namespaces used for tracking Kubernetes.\nIf the namespace list is empty, the list of denied namespaces is applied."
        },
        "denyList": {
          "$ref": "#/definitions/ConfigJSONFilter",
          "description": "deny_list specifies a list of namespaces that should not be used for tracking Kubernetes.\nIf both allow_list and deny_list filters are specified,\nallow_list is applied as the more specific and narrow list.\n\nIf both lists are empty, all available namespaces will be tracked."
        }
      }
    },
    "ConfigJSONFilter": {
      "type": "object",
      "properties": {
        "namespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "kube_configConfig": {
      "type": "object",
      "properties": {
